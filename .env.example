# Vorlage fuer die lokale .env dieser Storefront.
# Die echte .env wird NICHT eingecheckt (siehe .gitignore) — sie enthaelt
# das Session-Geheimnis. Kopieren mit:  cp .env.example .env
#
# Die vier PUBLIC_*-Werte kommen aus dem Shopify-Adminbereich, sobald dort
# die Hydrogen-Storefront "qi-master" angelegt ist (Hydrogen > Storefronts).
# Bis dahin laeuft `npm run dev` ohne diese Werte gegen mock.shop
# (Platzhalter-Produkte), nicht gegen den echten Katalog.

# Selbst erzeugen, z. B.:  openssl rand -base64 32
SESSION_SECRET=""

# Derselbe Shopify-Shop wie qiblanco.com.
PUBLIC_STORE_DOMAIN="qi-blanco.myshopify.com"

# Oeffentlicher Storefront-API-Token dieser Storefront (Shopify-Admin).
PUBLIC_STOREFRONT_API_TOKEN=""

# Die von Shopify vergebene Nummer dieser Hydrogen-Storefront (Shopify-Admin).
PUBLIC_STOREFRONT_ID=""

# Der Kaufweg bleibt bewusst auf der bestehenden Checkout-Domain des Shops.
PUBLIC_CHECKOUT_DOMAIN="checkout.qiblanco.com"
